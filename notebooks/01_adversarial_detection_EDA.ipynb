import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# 1. Load the data generated by your GitHub Action
df = pd.read_csv('../data/raw/transactions.csv')

# 2. Identify "Burst" Signatures
# We group by timestamp and count how many transactions happen at once
velocity_df = df.groupby('timestamp').size().reset_index(name='transaction_count')

# Filter for anything where more than 10 transactions happen in 1 millisecond
burst_attacks = velocity_df[velocity_df['transaction_count'] > 10]

print(f"Detected {len(burst_attacks)} potential Agentic Burst Attacks.")

# 3. Visualize the Signature (Senior Level Communication)
plt.figure(figsize=(12, 6))
sns.histplot(data=df, x='amount', hue='is_fraud', bins=50, kde=True)
plt.title('Distribution of Transaction Amounts: Human vs. Agentic Bot')
plt.show()
